  "format": "storyformers-online-v1",
  "base_model_sha256": "dd83d402ab1a6f92c8e61e5dfc20a0ebf774cc67f043246a97dbdd4ecf4bccb0",
  "rationale": "The batch exposes an overly broad high-weight <END> rule: it treats any final punctuation, including an introductory comma, as a strong story ending. Narrow that evidence by reducing the generic punctuation rule and restoring strong support for endings after end/End/ends followed by a period and after an exclamation mark. The latter also covers the replayed 'story ends.' ending. Names following an introductory comma often repeat a person already named in the prefix; project that captured name and use it to support the matching proper-name output, without requiring a particular name. The batch also repeatedly has a possessive marker after a proper noun, so add a POS-based rule for that continuation. These patterns may still favor an ending after a genuine non-final exclamation mark, or a repeated name after a comma in a context where another continuation is intended; other continuations remain possible, and the replay gate has not been evaluated.",
  "feature_definitions": {
    "preceding_person_token": {
      "type": "string",
      "description": "A proper-noun token captured somewhere before a terminal comma in the visible prefix; derived only from that prefix."
    }
  },
