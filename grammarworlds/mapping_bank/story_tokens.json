    {
      "id": "fetch.shared_tool",
      "weight": 1,
      "profiles": [
        "catalog"
      ],
      "source": {
        "scenarios": [
          "key",
          "kite",
          "library"
        ],
        "kinds": [
          "fetch_light",
          "fetch_scissors",
          "borrow"
        ],
        "bind": {
          "worker": "frame.actor",
          "item": "movements.0.item",
          "supply": "movements.0.source"
        },
        "equals": {
          "movements_count": 1,
          "movements.0.destination": "$worker",
          "changes": [
            {
              "entity": "$item",
              "field": "location",
              "before": "$supply",
              "after": "$worker"
            }
          ]
        },
        "role_kinds": {
          "worker": "person",
          "item": "tool"
        },
        "absent": [
          "movements.0.source_holder"
        ]
      },
      "target": {
        "id": "fetch_shared_tool",
        "event": {
          "op": "fetch",
          "actor": "worker",
          "item": "item",
          "source": "supply"
        },
        "roles": {
          "worker": {
            "kind": "person",
            "properties": [
              "can_hold"
            ]
          },
          "item": {
            "kind": "tool",
            "properties": [
              "portable"
            ]
          },
          "supply": {
            "kind": "place",
