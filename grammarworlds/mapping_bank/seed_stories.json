{
  "schema": "event-mapping-bank-v1",
  "rules": [
    {
      "id": "seed.fetch.object",
      "weight": 1,
      "profiles": [
        "catalog"
      ],
      "source": {
        "scenarios": [
          "bakery",
          "costume",
          "picnic"
        ],
        "kinds": [
          "borrow_basket",
          "borrow_blanket",
          "borrow_cape",
          "fetch_sun"
        ],
        "bind": {
          "worker": "frame.actor",
          "item": "movements.0.item",
          "supply": "movements.0.source"
        },
        "role_kinds": {
          "worker": "person",
          "item": "object",
          "supply": "place"
        },
        "equals": {
          "movements_count": 1,
          "changes": [
            {
              "entity": "$item",
              "field": "location",
              "before": "$supply",
              "after": "$worker"
            }
          ]
        },
        "absent": [
          "movements.0.source_holder"
        ]
      },
      "target": {
        "id": "seed_fetch",
        "event": {
          "op": "fetch",
          "actor": "worker",
          "item": "item",
          "source": "supply"
        },
        "roles": {
          "worker": {
            "kind": "person",
            "properties": [
              "can_hold"
            ]
          },
          "item": {
            "kind": "object",
            "properties": [
              "portable"
            ]
          },
          "supply": {
            "kind": "place",
            "properties": [
              "reachable"
            ]
          }
        }
      }
    },
