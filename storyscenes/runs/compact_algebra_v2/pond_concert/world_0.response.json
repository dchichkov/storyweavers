          "text": "{\n  \"title\": \"The Pond Concert Promise\",\n  \"premise\": \"A frog and two children want a pond concert, but a floating lily pad, a changeable breeze, and a mistaken guess about a quiet neighbor must be sorted out first.\",\n  \"entities\": {\n    \"ada\": {\n      \"name\": \"Ada\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"location\": \"garden\",\n        \"want\": \"invite the neighbor\",\n        \"delivered\": false\n      }\n    },\n    \"ben\": {\n      \"name\": \"Ben\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"location\": \"garden\",\n        \"want\": \"help the concert\",\n        \"helped\": false\n      }\n    },\n    \"frog\": {\n      \"name\": \"Frog\",\n      \"kind\": \"animal\",\n      \"state\": {\n        \"location\": \"pond\",\n        \"want\": \"perform a pond concert\",\n        \"performance_style\": \"undecided\",\n        \"performed\": false\n      }\n    },\n    \"neighbor\": {\n      \"name\": \"Mira\",\n      \"kind\": \"listener\",\n      \"state\": {\n        \"location\": \"porch\",\n        \"want\": \"quiet\",\n        \"responded\": false,\n        \"response\": null\n      }\n    },\n    \"garden\": {\n      \"name\": \"garden\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"kind\": \"garden\"\n      }\n    },\n    \"porch\": {\n      \"name\": \"porch\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"kind\": \"porch\"\n      }\n    },\n    \"pond\": {\n      \"name\": \"pond\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"wind\": \"still\",\n        \"pad_secured\": false,\n        \"outcome\": \"none\"\n      }\n    },\n    \"invitation\": {\n      \"name\": \"painted invitation\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"garden\",\n        \"delivered\": false\n      }\n    },\n    \"drum\": {\n      \"name\": \"acorn drum\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"frog\",\n        \"location\": \"garden\"\n      }\n    },\n    \"lily_pad\": {\n      \"name\": \"wide lily pad\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"garden\"\n      }\n    }\n  },\n  \"vary\": {\n    \"weather\": [\n      {\n        \"pond.wind\": \"still\"\n      },\n      {\n        \"pond.wind\": \"breezy\"\n      }\n    ],\n    \"listener_mood\": [\n      {\n        \"neighbor.want\": \"quiet\"\n      },\n      {\n        \"neighbor.want\": \"join\"\n      }\n    ]\n  },\n  \"premises\": [\n    \"pond.wind\",\n    \"neighbor.want\"\n  ],\n  \"kernels\": {},\n  \"compose\": {\n    \"wind_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"frog\",\n        \"ada\",\n        \"pond.wind\"\n      ],\n      \"summary\": \"Frog notices the pond wind and shares the news\",\n      \"weight\": 1\n    },\n    \"wish_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"frog\",\n        \"neighbor.want\"\n      ],\n      \"summary\": \"Ada learns what Mira wants and tells Frog\",\n      \"weight\": 1\n    },\n    \"move_invitation\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"invitation\",\n        \"porch\"\n      ],\n      \"when\": {\n        \"ada.location\": \"garden\",\n        \"invitation.owner\": \"ada\",\n        \"invitation.location\": \"garden\"\n      },\n      \"summary\": \"Ada carries the invitation to the porch\",\n      \"pivotal\": true\n    },\n    \"walk_to_porch\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"invitation.location\": \"porch\",\n        \"ada.location\": \"garden\"\n      },\n      \"set\": {\n        \"ada.location\": \"porch\"\n      },\n      \"label\": \"walk to porch\",\n      \"summary\": \"Ada walks up to the porch\"\n    },\n    \"deliver_invitation\": {\n      \"op\": \"Transfer\",\n      \"args\": [\n        \"ada\",\n        \"neighbor\",\n        \"invitation\"\n      ],\n      \"when\": {\n        \"ada.location\": \"porch\",\n        \"invitation.location\": \"porch\",\n        \"neighbor.location\": \"porch\",\n        \"ada.knows.neighbor.want\": [\n          \"ne\",\n          null\n        ]\n      },\n      \"summary\": \"Ada gives Mira the painted invitation\",\n      \"pivotal\": true\n    },\n    \"mark_delivery\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"invitation.owner\": \"neighbor\"\n      },\n      \"set\": {\n        \"invitation.delivered\": true,\n        \"ada.delivered\": true\n      },\n      \"label\": \"invitation delivered\",\n      \"summary\": \"The invitation is safely delivered\"\n    },\n    \"move_drum\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"frog\",\n        \"drum\",\n        \"pond\"\n      ],\n      \"when\": {\n        \"drum.owner\": \"frog\",\n        \"drum.location\": \"garden\"\n      },\n      \"summary\": \"Frog brings the acorn drum to the pond\"\n    },\n    \"move_lily_pad\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"lily_pad\",\n        \"pond\"\n      ],\n      \"when\": {\n        \"ada.location\": \"garden\",\n        \"lily_pad.owner\": \"ada\",\n        \"lily_pad.location\": \"garden\"\n      },\n      \"summary\": \"Ada floats the wide lily pad onto the pond\"\n    },\n    \"secure_breezy_pad\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\",\n        \"ben\"\n      ],\n      \"when\": {\n        \"pond.wind\": \"breezy\",\n        \"lily_pad.location\": \"pond\",\n        \"ada.knows.pond.wind\": \"breezy\"\n      },\n      \"set\": {\n        \"pond.pad_secured\": true,\n        \"ben.helped\": true\n      },\n      \"label\": \"secure the lily pad\",\n      \"summary\": \"Ada and Ben anchor the lily pad against the breeze\",\n      \"pivotal\": true\n    },\n    \"quiet_performance\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"frog\"\n      ],\n      \"when\": {\n        \"frog.knows.neighbor.want\": \"quiet\",\n        \"drum.location\": \"pond\",\n        \"frog.performed\": false\n      },\n      \"set\": {\n        \"frog.performance_style\": \"gentle\",\n        \"frog.performed\": true,\n        \"pond.outcome\": \"quiet_song\"\n      },\n      \"label\": \"gentle pond song\",\n      \"summary\": \"Frog plays a gentle song for a quiet listener\",\n      \"pivotal\": true\n    },\n    \"lively_still_performance\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"frog\"\n      ],\n      \"when\": {\n        \"frog.knows.neighbor.want\": \"join\",\n        \"pond.wind\": \"still\",\n        \"lily_pad.location\": \"pond\",\n        \"frog.performed\": false\n      },\n      \"set\": {\n        \"frog.performance_style\": \"lily-pad rhythm\",\n        \"frog.performed\": true,\n        \"pond.outcome\": \"lively_jam\"\n      },\n      \"label\": \"lily-pad rhythm\",\n      \"summary\": \"Frog starts a lively rhythm on the still pond\",\n      \"pivotal\": true\n    },\n    \"lively_breezy_performance\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"frog\"\n      ],\n      \"when\": {\n        \"frog.knows.neighbor.want\": \"join\",\n        \"pond.wind\": \"breezy\",\n        \"pond.pad_secured\": true,\n        \"lily_pad.location\": \"pond\",\n        \"frog.performed\": false\n      },\n      \"set\": {\n        \"frog.performance_style\": \"anchored lily-pad rhythm\",\n        \"frog.performed\": true,\n        \"pond.outcome\": \"lively_jam\"\n      },\n      \"label\": \"anchored lily-pad rhythm\",\n      \"summary\": \"Frog turns the anchored pad into a lively rhythm\",\n      \"pivotal\": true\n    },\n    \"quiet_response\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"neighbor\"\n      ],\n      \"when\": {\n        \"neighbor.want\": \"quiet\",\n        \"pond.outcome\": \"quiet_song\",\n        \"frog.performed\": true,\n        \"neighbor.responded\": false\n      },\n      \"set\": {\n        \"neighbor.responded\": true,\n        \"neighbor.response\": \"smiles and listens\"\n      },\n      \"label\": \"quiet welcome\",\n      \"summary\": \"Mira smiles at the gentle pond song\",\n      \"pivotal\": true\n    },\n    \"joining_response\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"neighbor\"\n      ],\n      \"when\": {\n        \"neighbor.want\": \"join\",\n        \"pond.outcome\": \"lively_jam\",\n        \"frog.performed\": true,\n        \"neighbor.responded\": false\n      },\n      \"set\": {\n        \"neighbor.responded\": true,\n        \"neighbor.response\": \"joins the rhythm\"\n      },\n      \"label\": \"neighbor joins\",\n      \"summary\": \"Mira joins the lively pond rhythm\",\n      \"pivotal\": true\n    }\n  },\n  \"goal\": {\n    \"invitation.owner\": \"neighbor\",\n    \"invitation.delivered\": true,\n    \"frog.performed\": true,\n    \"neighbor.responded\": true,\n    \"pond.outcome\": [\n      \"ne\",\n      \"none\"\n    ]\n  },\n  \"outcomes\": [\n    \"invitation.owner\",\n    \"invitation.delivered\",\n    \"frog.performance_style\",\n    \"frog.performed\",\n    \"pond.outcome\",\n    \"neighbor.responded\",\n    \"neighbor.response\",\n    \"pond.pad_secured\"\n  ],\n  \"prune\": true\n}",
