          "text": "{\n  \"title\": \"The Roof-Garden Invitations\",\n  \"premise\": \"Ada and a young dragon must get invitations across a windy roof garden while learning how to help in the way their neighbor needs.\",\n  \"entities\": {\n    \"ada\": {\n      \"name\": \"Ada\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"deliver invitations\",\n        \"memes.Care\": 2,\n        \"delivered\": false,\n        \"performance_style\": \"careful\"\n      }\n    },\n    \"dragon\": {\n      \"name\": \"Pip\",\n      \"kind\": \"young_dragon\",\n      \"state\": {\n        \"want\": \"help\",\n        \"memes.Care\": 1,\n        \"confidence\": 1,\n        \"carry_method\": \"unset\",\n        \"performance_style\": \"ordinary\"\n      }\n    },\n    \"neighbor\": {\n      \"name\": \"Mina\",\n      \"kind\": \"neighbor_child\",\n      \"state\": {\n        \"want\": \"quiet\",\n        \"received\": false,\n        \"response\": \"none\",\n        \"location\": \"neighbor_roof\"\n      }\n    },\n    \"invitations\": {\n      \"name\": \"invitations\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"roof_garden\",\n        \"fragile\": true,\n        \"secured\": false,\n        \"delivered\": false,\n        \"loaned_by\": null\n      }\n    },\n    \"ribbon\": {\n      \"name\": \"ribbon\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"dragon\",\n        \"location\": \"roof_garden\",\n        \"tied\": false,\n        \"loaned_by\": null\n      }\n    },\n    \"bell\": {\n      \"name\": \"bell\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"dragon\",\n        \"location\": \"roof_garden\",\n        \"rung\": false,\n        \"loaned_by\": null\n      }\n    },\n    \"garden\": {\n      \"name\": \"roof garden\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"wind\": \"breezy\"\n      }\n    },\n    \"neighbor_roof\": {\n      \"name\": \"neighbor roof\",\n      \"kind\": \"place\",\n      \"state\": {}\n    }\n  },\n  \"vary\": {\n    \"weather\": [\n      {\n        \"garden.wind\": \"still\"\n      },\n      {\n        \"garden.wind\": \"breezy\"\n      }\n    ],\n    \"recipient\": [\n      {\n        \"neighbor.want\": \"quiet\"\n      },\n      {\n        \"neighbor.want\": \"join\"\n      }\n    ],\n    \"cargo\": [\n      {\n        \"invitations.fragile\": true\n      },\n      {\n        \"invitations.fragile\": false\n      }\n    ]\n  },\n  \"premises\": [\n    \"garden.wind\",\n    \"neighbor.want\",\n    \"invitations.fragile\"\n  ],\n  \"kernels\": {},\n  \"compose\": {\n    \"weather_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"dragon\",\n        \"garden.wind\"\n      ],\n      \"summary\": \"Ada and Pip compare the garden wind\",\n      \"divide\": 1\n    },\n    \"wish_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"dragon\",\n        \"ada\",\n        \"neighbor.want\"\n      ],\n      \"summary\": \"Pip learns what Mina hopes for\",\n      \"divide\": 1\n    },\n    \"cargo_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"dragon\",\n        \"invitations.fragile\"\n      ],\n      \"summary\": \"Ada shows Pip how delicate the invitations are\",\n      \"divide\": 1\n    },\n    \"protect_fragile\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\",\n        \"dragon\"\n      ],\n      \"when\": {\n        \"dragon.knows.garden.wind\": [\n          \"ne\",\n          null\n        ],\n        \"dragon.knows.invitations.fragile\": true,\n        \"invitations.owner\": \"ada\",\n        \"ribbon.owner\": \"dragon\",\n        \"invitations.location\": \"roof_garden\",\n        \"ribbon.location\": \"roof_garden\"\n      },\n      \"set\": {\n        \"invitations.secured\": true,\n        \"ribbon.tied\": true,\n        \"dragon.carry_met