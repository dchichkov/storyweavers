          "text": "{\n  \"title\": \"The Parade That Carried Good News\",\n  \"premise\": \"A boastful mayor wants the biggest parade, but a child librarian, a helpful cart builder, and one shared cart turn that ambition toward something useful.\",\n  \"entities\": {\n    \"ada\": {\n      \"name\": \"Ada\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"deliver a book\",\n        \"courage\": 2,\n        \"delivered\": false,\n        \"location\": \"library\"\n      }\n    },\n    \"mayor\": {\n      \"name\": \"Mayor Bell\",\n      \"kind\": \"adult\",\n      \"state\": {\n        \"want\": \"the biggest parade\",\n        \"boastful\": true,\n        \"performance_style\": null,\n        \"response\": \"none\",\n        \"location\": \"square\"\n      }\n    },\n    \"builder\": {\n      \"name\": \"Bram\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"make useful things\",\n        \"skill\": 3,\n        \"location\": \"workshop\"\n      }\n    },\n    \"recipient\": {\n      \"name\": \"Nell\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"quiet\",\n        \"received\": false,\n        \"response\": \"none\",\n        \"location\": \"square\"\n      }\n    },\n    \"cart\": {\n      \"name\": \"the shared cart\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"builder\",\n        \"location\": \"workshop\",\n        \"condition\": \"ready\",\n        \"cover\": \"loose\"\n      }\n    },\n    \"book\": {\n      \"name\": \"the library book\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"library\"\n      }\n    },\n    \"library\": {\n      \"name\": \"library\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"open\": true\n      }\n    },\n    \"workshop\": {\n      \"name\": \"workshop\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"open\": true\n      }\n    },\n    \"square\": {\n      \"name\": \"town square\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"wind\": \"still\"\n      }\n    }\n  },\n  \"vary\": {\n    \"weather\": [\n      {\n        \"square.wind\": \"still\"\n      },\n      {\n        \"square.wind\": \"breezy\"\n      }\n    ],\n    \"recipient_wish\": [\n      {\n        \"recipient.want\": \"quiet\"\n      },\n      {\n        \"recipient.want\": \"join\"\n      }\n    ],\n    \"cart_start\": [\n      {\n        \"cart.condition\": \"ready\"\n      },\n      {\n        \"cart.condition\": \"damaged\"\n      }\n    ]\n  },\n  \"premises\": [\n    \"square.wind\",\n    \"recipient.want\",\n    \"cart.condition\"\n  ],\n  \"compose\": {\n    \"wind_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"builder\",\n        \"square.wind\"\n      ]\n    },\n    \"wish_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"mayor\",\n        \"recipient.want\"\n      ]\n    },\n    \"cart_notice\": {\n      \"op\": \"Observe\",\n      \"args\": [\n        \"builder\",\n        \"cart.condition\"\n      ],\n      \"summary\": \"Bram checks the cart\"\n    },\n    \"repair_cart\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"builder\"\n      ],\n      \"when\": {\n        \"cart.owner\": \"builder\",\n        \"cart.condition\": \"damaged\",\n        \"builder.knows.cart.condition\": \"damaged\"\n      },\n      \"set\": {\n        \"cart.condition\": \"ready\"\n      },\n      \"summary\": \"Bram repairs the cart\",\n      \"pivotal\": true\n    },\n    \"tie_cover\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"builder\"\n      ],\n      \"when\": {\n        \"cart.owner\": \"builder\",\n        \"square.wind\": \"breezy\",\n        \"builder.knows.square.wind\": \"breezy\"\n      },\n      \"set\": {\n        \"cart.cover\": \"tied\"\n      },\n      \"summary\": \"Bram ties down the cart cover\",\n      \"pivotal\": true\n    },\n    \"lend_cart\": {\n      \"op\": \"Lend\",\n      \"args\": [\n        \"builder\",\n        \"ada\",\n        \"cart\"\n      ],\n      \"when\": [\n        [\n          \"cart.condition\",\n          \"eq\",\n          \"ready\"\n        ],\n        [\n          \"square.wind\",\n          \"eq\",\n          \"still\"\n        ]\n      ],\n      \"summary\": \"Bram lends Ada the cart\"\n    },\n    \"lend_cart_windy\": {\n      \"op\": \"Lend\",\n      \"args\": [\n        \"builder\",\n        \"ada\",\n        \"cart\"\n      ],\n      \"when\": [\n        [\n          \"cart.condition\",\n          \"eq\",\n          \"ready\"\n        ],\n        [\n          \"square.wind\",\n          \"eq\",\n          \"breezy\"\n        ],\n        [\n          \"cart.cover\",\n          \"eq\",\n          \"tied\"\n        ]\n      ],\n      \"summary\": \"Bram lends Ada the secured cart\"\n    },\n    \"bring_cart_to_library\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"cart\",\n        \"library\"\n      ],\n      \"when\": {\n        \"cart.location\": \"workshop\"\n      },\n      \"summary\": \"Ada brings the cart to the library\"\n    },\n    \"load_book\": {\n      \"op\": \"Transfer\",\n      \"args\": [\n        \"ada\",\n        \"ada\",\n        \"book\"\n      ],\n      \"when\": {\n        \"cart.location\": \"library\"\n      },\n      \"summary\": \"Ada loads the library book\"\n    },\n    \"bring_cart_to_square\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"cart\",\n        \"square\"\n      ],\n      \"when\": {\n        \"cart.location\": \"library\"\n      },\n      \"summary\": \"Ada rolls the cart to the square\"\n    },\n    \"deliver_quietly\": {\n      \"op\": \"Transfer\",\n      \"args\": [\n        \"ada\",\n        \"recipient\",\n        \"book\"\n      ],\n      \"when\": [\n        [\n          \"cart.location\",\n          \"eq\",\n          \"square\"\n        ],\n        [\n          \"ada.knows.recipient.want\",\n          \"eq\",\n          \"quiet\"\n        ],\n        [\n          \"square.wind\",\n          \"eq\",\n          \"still\"\n        ]\n      ],\n      \"summary\": \"Ada delivers Nell's book quietly\",\n      \"pivotal\": true\n    },\n    \"deliver_under_cover\": {\n      \"op\": \"Transfer\",\n      \"args\": [\n        \"ada\",\n        \"recipient\",\n        \"book\"\n      ],\n      \"when\": [\n        [\n          \"cart.location\",\n          \"eq\",\n          \"square\"\n        ],\n        [\n          \"ada.knows.recipient.want\",\n          \"eq\",\n          \"quiet\"\n        ],\n        [\n          \"square.wind\",\n          \"eq\",\n          \"breezy\"\n        ],\n        [\n          \"cart.cover\",\n          \"eq\",\n          \"tied\"\n        ]\n      ],\n      \"summary\": \"Ada delivers Nell's book under cover\",\n      \"pivotal\": true\n    },\n    \"deliver_for_joiners\": {\n      \"op\": \"Transfer\",\n      \"args\": [\n        \"ada\",\n        \"recipient\",\n        \"book\"\n      ],\n      \"when\": [\n        [\n          \"cart.location\",\n          \"eq\",\n          \"square\"\n        ],\n        [\n          \"ada.knows.recipient.want\",\n          \"eq\",\n          \"join\"\n        ],\n        [\n          \"cart.condition\",\n          \"eq\",\n          \"ready\"\n        ]\n      ],\n      \"summary\": \"Ada delivers the book to a new parade helper\",\n      \"pivotal\": true\n    },\n    \"mayor_observes_delivery\": {\n      \"op\": \"Observe\",\n      \"args\": [\n        \"mayor\",\n        \"book.owner\"\n      ],\n      \"when\": {\n        \"book.owner\": \"recipient\"\n      },\n      \"summary\": \"The mayor notices the delivered book\"\n    },\n    \"quiet_procession\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": [\n        [\n          \"book.owner\",\n          \"eq\",\n          \"recipient\"\n        ],\n        [\n          \"mayor.knows.book.owner\",\n          \"eq\",\n          \"recipient\"\n        ],\n        [\n          \"mayor.knows.recipient.want\",\n          \"eq\",\n          \"quiet\"\n        ]\n      ],\n      \"set\": {\n        \"mayor.performance_style\": \"quiet_procession\",\n        \"mayor.response\": \"proud\",\n        \"mayor.boastful\": false,\n        \"recipient.received\": true,\n        \"recipient.response\": \"grateful\"\n      },\n      \"summary\": \"The mayor leads a quiet book procession\",\n      \"pivotal\": true\n    },\n    \"welcoming_parade\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": [\n        [\n          \"book.owner\",\n          \"eq\",\n          \"recipient\"\n        ],\n        [\n          \"mayor.knows.book.owner\",\n          \"eq\",\n          \"recipient\"\n        ],\n        [\n          \"mayor.knows.recipient.want\",\n          \"eq\",\n          \"join\"\n        ]\n      ],\n      \"set\": {\n        \"mayor.performance_style\": \"welcoming_parade\",\n        \"mayor.response\": \"cheering\",\n        \"mayor.boastful\": false,\n        \"recipient.received\": true,\n        \"recipient.response\": \"delighted\"\n      },\n      \"summary\": \"The mayor welcomes Nell into the parade\",\n      \"pivotal\": true\n    }\n  },\n  \"goal\": [\n    [\n      \"book.owner\",\n      \"eq\",\n      \"recipient\"\n    ],\n    [\n      \"recipient.received\",\n      \"eq\",\n      true\n    ],\n    [\n      \"mayor.performance_style\",\n      \"ne\",\n      null\n    ],\n    [\n      \"mayor.response\",\n      \"ne\",\n      \"none\"\n    ],\n    [\n      \"mayor.boastful\",\n      \"eq\",\n      false\n    ]\n  ],\n  \"outcomes\": [\n    \"book.owner\",\n    \"recipient.received\",\n    \"recipient.response\",\n    \"mayor.performance_style\",\n    \"mayor.response\",\n    \"mayor.boastful\",\n    \"cart.condition\",\n    \"cart.cover\"\n  ],\n  \"prune\": true\n}",
