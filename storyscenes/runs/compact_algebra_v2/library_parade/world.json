{
  "title": "The Parade That Carried Good News",
  "premise": "A boastful mayor wants the biggest parade, but a child librarian, a helpful cart builder, and one shared cart turn that ambition toward something useful.",
  "entities": {
    "ada": {
      "name": "Ada",
      "kind": "child",
      "state": {
        "want": "deliver a book",
        "courage": 2,
        "delivered": false,
        "location": "library"
      }
    },
    "mayor": {
      "name": "Mayor Bell",
      "kind": "adult",
      "state": {
        "want": "the biggest parade",
        "boastful": true,
        "performance_style": null,
        "response": "none",
        "location": "square"
      }
    },
    "builder": {
      "name": "Bram",
      "kind": "child",
      "state": {
        "want": "make useful things",
        "skill": 3,
        "location": "workshop"
      }
    },
    "recipient": {
      "name": "Nell",
      "kind": "child",
      "state": {
        "want": "quiet",
        "received": false,
        "response": "none",
        "location": "square"
      }
    },
    "cart": {
      "name": "the shared cart",
      "kind": "prop",
      "state": {
        "owner": "builder",
        "location": "workshop",
        "condition": "ready",
        "cover": "loose"
      }
    },
    "book": {
      "name": "the library book",
      "kind": "prop",
      "state": {
        "owner": "ada",
        "location": "library"
      }
    },
    "library": {
      "name": "library",
      "kind": "place",
      "state": {
        "open": true
      }
    },
    "workshop": {
      "name": "workshop",
      "kind": "place",
      "state": {
        "open": true
      }
    },
    "square": {
      "name": "town square",
      "kind": "place",
      "state": {
        "wind": "still"
      }
    }
  },
  "vary": {
    "weather": [
      {
        "square.wind": "still"
      },
      {
        "square.wind": "breezy"
      }
    ],
    "recipient_wish": [
      {
        "recipient.want": "quiet"
      },
      {
        "recipient.want": "join"
      }
    ],
    "cart_start": [
      {
        "cart.condition": "ready"
      },
      {
        "cart.condition": "damaged"
      }
    ]
  },
  "premises": [
    "square.wind",
    "recipient.want",
    "cart.condition"
  ],
  "compose": {
    "wind_news": {
      "op": "DiscoverAndShare",
      "args": [
        "ada",
        "builder",
        "square.wind"
      ]
    },
    "wish_news": {
      "op": "DiscoverAndShare",
      "args": [
        "ada",
        "mayor",
        "recipient.want"
      ]
    },
    "cart_notice": {
      "op": "Observe",
      "args": [
        "builder",
        "cart.condition"
      ],
      "summary": "Bram checks the cart"
    },
    "repair_cart": {
      "op": "Act",
      "actors": [
        "builder"
      ],
      "when": {
        "cart.owner": "builder",
        "cart.condition": "damaged",
        "builder.knows.cart.condition": "damaged"
      },
      "set": {
        "cart.condition": "ready"
      },
      "summary": "Bram repairs the cart",
      "pivotal": true
    },
    "tie_cover": {
      "op": "Act",
      "actors": [
        "builder"
      ],
      "when": {
        "cart.owner": "builder",
        "square.wind": "breezy",
        "builder.knows.square.wind": "breezy"
      },
      "set": {
        "cart.cover": "tied"
      },
      "summary": "Bram ties down the cart cover",
      "pivotal": true
    },
    "lend_cart": {
      "op": "Lend",
      "args": [
        "builder",
        "ada",
        "cart"
      ],
      "when": [
        [
          "cart.condition",
          "eq",
          "ready"
        ],
        [
          "square.wind",
          "eq",
          "still"
        ]
      ],
      "summary": "Bram lends Ada the cart"
    },
    "lend_cart_windy": {
      "op": "Lend",
      "args": [
        "builder",
        "ada",
        "cart"
      ],
      "when": [
        [
          "cart.condition",
          "eq",
          "ready"
        ],
        [
          "square.wind",
          "eq",
          "breezy"
        ],
        [
          "cart.cover",
          "eq",
          "tied"
        ]
      ],
      "summary": "Bram lends Ada the secured cart"
    },
    "bring_cart_to_library": {
      "op": "Move",
      "args": [
        "ada",
        "cart",
        "library"
      ],
      "when": {
        "cart.location": "workshop"
      },
      "summary": "Ada brings the cart to the library"
    },
    "load_book": {
      "op": "Transfer",
      "args": [
        "ada",
        "ada",
        "book"
      ],
      "when": {
        "cart.location": "library"
      },
      "summary": "Ada loads the library book"
    },
    "bring_cart_to_square": {
      "op": "Move",
      "args": [
        "ada",
        "cart",
        "square"
      ],
      "when": {
        "cart.location": "library"
      },
      "summary": "Ada rolls the cart to the square"
    },
    "deliver_quietly": {
      "op": "Transfer",
      "args": [
        "ada",
        "recipient",
        "book"
      ],
      "when": [
        [
          "cart.location",
          "eq",
          "square"
        ],
        [
          "ada.knows.recipient.want",
          "eq",
          "quiet"
        ],
        [
          "square.wind",
          "eq",
          "still"
        ]
      ],
      "summary": "Ada delivers Nell's book quietly",
      "pivotal": true
    },
    "deliver_under_cover": {
      "op": "Transfer",
      "args": [
        "ada",
        "recipient",
        "book"
      ],
      "when": [
        [
          "cart.location",
          "eq",
          "square"
        ],
        [
          "ada.knows.recipient.want",
          "eq",
          "quiet"
        ],
        [
          "square.wind",
          "eq",
          "breezy"
        ],
        [
          "cart.cover",
          "eq",
          "tied"
        ]
      ],
      "summary": "Ada delivers Nell's book under cover",
      "pivotal": true
    },
    "deliver_for_joiners": {
      "op": "Transfer",
      "args": [
        "ada",
        "recipient",
        "book"
      ],
      "when": [
        [
          "cart.location",
          "eq",
          "square"
        ],
        [
          "ada.knows.recipient.want",
          "eq",
          "join"
        ],
        [
          "cart.condition",
          "eq",
          "ready"
        ]
      ],
      "summary": "Ada delivers the book to a new parade helper",
      "pivotal": true
    },
    "mayor_observes_delivery": {
      "op": "Observe",
      "args": [
        "mayor",
        "book.owner"
      ],
      "when": {
        "book.owner": "recipient"
      },
      "summary": "The mayor notices the delivered book"
    },
    "quiet_procession": {
      "op": "Act",
      "actors": [
        "mayor"
      ],
      "when": [
        [
          "book.owner",
          "eq",
          "recipient"
        ],
        [
          "mayor.knows.book.owner",
          "eq",
          "recipient"
        ],
        [
          "mayor.knows.recipient.want",
          "eq",
          "quiet"
        ]
      ],
      "set": {
        "mayor.performance_style": "quiet_procession",
        "mayor.response": "proud",
        "mayor.boastful": false,
        "recipient.received": true,
        "recipient.response": "grateful"
      },
      "summary": "The mayor leads a quiet book procession",
      "pivotal": true
    },
    "welcoming_parade": {
      "op": "Act",
      "actors": [
        "mayor"
      ],
      "when": [
        [
          "book.owner",
          "eq",
          "recipient"
        ],
        [
          "mayor.knows.book.owner",
          "eq",
          "recipient"
        ],
        [
          "mayor.knows.recipient.want",
          "eq",
          "join"
        ]
      ],
      "set": {
        "mayor.performance_style": "welcoming_parade",
        "mayor.response": "cheering",
        "mayor.boastful": false,
        "recipient.received": true,
        "recipient.response": "delighted"
      },
      "summary": "The mayor welcomes Nell into the parade",
      "pivotal": true
    }
  },
  "goal": [
    [
      "book.owner",
      "eq",
      "recipient"
    ],
    [
      "recipient.received",
      "eq",
      true
    ],
    [
      "mayor.performance_style",
      "ne",
      null
    ],
    [
      "mayor.response",
      "ne",
      "none"
    ],
    [
      "mayor.boastful",
      "eq",
      false
    ]
  ],
  "outcomes": [
    "book.owner",
    "recipient.received",
    "recipient.response",
    "mayor.performance_style",
    "mayor.response",
    "mayor.boastful",
    "cart.condition",
    "cart.cover"
  ],
  "prune": true
}
