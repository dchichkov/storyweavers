          "text": "{\"edits\":[{\"path\":\"/endings/-\",\"value_json\":\"{\\\"text\\\":\\\"The cart stood in the parade lane as a towering float, its enormous banner lifting above the stones like a bright red sail. Mallow beamed at it, while Tuck gave the wooden handle an affectionate pat.\\\",\\\"when\\\":[{\\\"key\\\":\\\"cart.mode\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"float\\\",\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/-\",\"value_json\":\"{\\\"text\\\":\\\"At the neighborhood stop, the loaded cart waited like a friendly little library on wheels. The bell hung ready beside the books, and a child peeped around the corner, already reaching for a story.\\\",\\\"when\\\":[{\\\"key\\\":\\\"cart.mode\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"bookmobile\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"cart.location\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"neighborhood_stop\\\",\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/-\",\"value_json\":\"{\\\"text\\\":\\\"In the parade lane, the cart opened its shelves into a tiny traveling reading room. Books nestled inside, waiting for the first listener to choose a place beside the wheels.\\\",\\\"when\\\":[{\\\"key\\\":\\\"cart.mode\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"reading_room\\\",\\\"at\\\":\\\"after\\\"}]}\"}]}",
