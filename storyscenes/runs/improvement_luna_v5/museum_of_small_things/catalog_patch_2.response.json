          "annotations": [],
          "text": "{\"edits\":[{\"path\":\"/scenes/15/variants/0/text\",\"value_json\":\"Ada led a whisper-tour past the little wonders. She breathed each treasure’s story, and the keeper leaned close, smiling as softly as dust settling on a windowsill.\"},{\"path\":\"/endings/0\",\"value_json\":\"{\\\"text\\\":\\\"The red marble rested beside its note, while Ben’s sister waved from the doorway. The keeper smiled at the borrowed treasure, and the marble gleamed like a tiny promise kept.\\\",\\\"when\\\":[{\\\"key\\\":\\\"display.status\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"trusted\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"ben.agreement\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"lend\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"visitor.mood\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"delighted\\\",\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/-\",\"value_json\":\"{\\\"text\\\":\\\"The marble had gone home to Ben’s sister, leaving a neat round space in the display. The keeper smiled at the little gap, and somewhere nearby the returned treasure rolled happily into its own familiar corner.\\\",\\\"when\\\":[{\\\"key\\\":\\\"display.status\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"trusted\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"ben.agreement\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"return\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"visitor.mood\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"delighted\\\",\\\"at\\\":\\\"after\\\"}]}\"}]}",
