          "annotations": [],
          "text": "{\"edits\":[{\"path\":\"/scenes/14\",\"value_json\":\"{\\\"scene\\\":\\\"quiet_bow\\\",\\\"role\\\":\\\"bridge\\\",\\\"variants\\\":[{\\\"text\\\":\\\"The last note settled over the pond, and Frog held his breath beside the listening reeds.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"soft\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}]}\"},{\"path\":\"/scenes/15\",\"value_json\":\"{\\\"scene\\\":\\\"duet_bow\\\",\\\"role\\\":\\\"bridge\\\",\\\"variants\\\":[{\\\"text\\\":\\\"The final twirl slowed, leaving Mia, Teo, and Frog poised above a pond full of tiny ripples.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"duet\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}]}\"},{\"path\":\"/scenes/16\",\"value_json\":\"{\\\"scene\\\":\\\"boat_bow\\\",\\\"role\\\":\\\"bridge\\\",\\\"variants\\\":[{\\\"text\\\":\\\"The floating concert drifted onward, with the leaf boat bumping gently behind the lily.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"boat\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}]}\"},{\"path\":\"/endings/0\",\"value_json\":\"{\\\"text\\\":\\\"A single silver bubble rose beside the lily. Nora’s eyelids lifted, Frog’s toes curled with pride, and the pond held the little song as carefully as a pocket holds a button.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"soft\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/1\",\"value_json\":\"{\\\"text\\\":\\\"The reeds shivered once, then rested. Frog’s enormous smile became quiet enough to fit beside Nora’s shining bubble in the moonlit water.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"soft\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/2\",\"value_json\":\"{\\\"text\\\":\\\"Mia’s feet pattered, Teo’s bell twinkled, and Nora tapped the water until the ripples looked like dancing commas. Frog bowed, accidentally wobbled, and made the commas wiggle harder.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"duet\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/3\",\"value_json\":\"{\\\"text\\\":\\\"The final lullaby-note floated away while Nora tapped a bright little rhythm. Ripples danced across the pond, and Mia’s grin was nearly as wide as Frog’s.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"duet\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/4\",\"value_json\":\"{\\\"text\\\":\\\"Nora glided past on the lily while Frog sang from its middle. The leaf boat bumped along behind like a very small royal carriage, carrying no crown—only a splendid wobble.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"boat\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/endings/5\",\"value_json\":\"{\\\"text\\\":\\\"The lily made a slow circle, with Nora smiling aboard and Frog singing in the middle. Behind them, the leaf boat bobbed after its queenly captain, one tiny bump at a time.\\\",\\\"when\\\":[{\\\"key\\\":\\\"concert.style\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"boat\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"frog.performed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"}]}\"}]}",
