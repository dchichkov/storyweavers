          "annotations": [],
          "text": "{\"edits\":[{\"path\":\"/openings/0/text\",\"value_json\":\"\\\"Ada swung open the garden gate and lifted the lamp. She wanted a grand parade of shadows, while Bo prepared a moonflower welcome for their shy visitor. Somewhere in the dark garden, Pip waited for an invitation gentle enough to follow.\\\"\"},{\"path\":\"/openings/1/text\",\"value_json\":\"\\\"Ada opened the gate with a flourish. \\\\u201cTonight, a moon performance!\\\\u201d she announced. Bo held up one quiet finger and prepared a soft-bell invitation. Somewhere nearby, a tiny moth listened.\\\"\"},{\"path\":\"/openings/2/text\",\"value_json\":\"\\\"The gate creaked open beneath the rising moon. Ada had planned a still paper-moon tableau, while Bo prepared a flowery welcome. They hoped their hidden guest would come close. Pip folded its wings and waited.\\\"\"},{\"path\":\"/openings/3/text\",\"value_json\":\"\\\"Ada opened the garden gate and bowed to the dark. \\\\u201cMy paper moon is ready!\\\\u201d she said. Bo kept a silver bell nearby for a quiet invitation. The shy moth waited somewhere in the garden.\\\"\"},{\"path\":\"/scenes/3/variants/0/text\",\"value_json\":\"\\\"Ada hurried to Bo. \\\\u201cPip is hiding under the leaves,\\\\u201d she said. Bo leaned closer, suddenly very interested in the quiet places.\\\"\"},{\"path\":\"/scenes/3/variants/0/when\",\"value_json\":\"[{\\\"key\\\":\\\"ada.knows.pip.location\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"leaves\\\",\\\"at\\\":\\\"after\\\"}]\"},{\"path\":\"/scenes/3/variants/-\",\"value_json\":\"{\\\"text\\\":\\\"Ada hurried to Bo. \\\\u201cPip is tucked behind the gate,\\\\u201d she said. Bo leaned closer, suddenly very interested in the quiet places.\\\",\\\"when\\\":[{\\\"key\\\":\\\"ada.knows.pip.location\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"gate\\\",\\\"at\\\":\\\"after\\\"}]}\"}]}",
          "type": "output_text",
          "logprobs": []
        }
