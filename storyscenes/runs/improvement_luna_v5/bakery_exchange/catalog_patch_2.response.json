          "text": "{\"edits\":[{\"path\":\"/scenes/0/variants/0\",\"value_json\":\"{\\\"text\\\":\\\"Pip pressed the paper label onto the button. \\\\u201cThere!\\\\u201d he cried. \\\\u201cA cinnamon crown for a cinnamon \\\\u2014well, probably cinnamon\\\\u2014button!\\\\u201d\\\",\\\"when\\\":[{\\\"key\\\":\\\"label.attached\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"button.mark\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"cinnamon\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"label.text\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"cinnamon\\\",\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/scenes/0/variants/1\",\"value_json\":\"{\\\"text\\\":\\\"Pip pressed the paper label onto the button. \\\\u201cThere!\\\\u201d he cried. \\\\u201cA peppery pennant for a very mysterious button!\\\\u201d His tail made a proud little question mark.\\\",\\\"when\\\":[{\\\"key\\\":\\\"label.attached\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"label.text\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"pepper\\\",\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/scenes/0/variants/-\",\"value_json\":\"{\\\"text\\\":\\\"Pip pressed the paper label onto the button. \\\\u201cThere!\\\\u201d he cried. \\\\u201cA cinnamon crown for this peppery button!\\\\u201d His tail made a proud little question mark.\\\",\\\"when\\\":[{\\\"key\\\":\\\"label.attached\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":true,\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"button.mark\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"pepper\\\",\\\"at\\\":\\\"after\\\"},{\\\"key\\\":\\\"label.text\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"cinnamon\\\",\\\"at\\\":\\\"after\\\"}]}\"},{\"path\":\"/openings/-\",\"value_json\":\"{\\\"text\\\":\\\"At Ada\\\\u2019s tiny bakery stall, Pip pinned a pepper label to the pepper-marked button and puffed proudly. Nia brought bright berry jam, and Ada promised a daring taste. The snack waited beneath its honest sign, ready for a brave little surprise.\\\",\\\"when\\\":[{\\\"key\\\":\\\"ada.promise\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"brave_taste\\\",\\\"at\\\":\\\"initial\\\"},{\\\"key\\\":\\\"button.mark\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"pepper\\\",\\\"at\\\":\\\"initial\\\"},{\\\"key\\\":\\\"label.text\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"pepper\\\",\\\"at\\\":\\\"initial\\\"}]}\"}]}",
