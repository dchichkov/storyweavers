          "text": "{\n  \"title\": \"The Parade That Helped\",\n  \"premise\": \"A boastful mayor wants the biggest parade. A child librarian, a helpful cart builder, and one shared cart turn that ambition toward something useful.\",\n  \"entities\": {\n    \"ada\": {\n      \"name\": \"Ada\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"deliver useful books\",\n        \"memes.Care\": 2,\n        \"performance_style\": \"careful\"\n      }\n    },\n    \"mayor\": {\n      \"name\": \"Mayor Bell\",\n      \"kind\": \"adult\",\n      \"state\": {\n        \"want\": \"the biggest parade\",\n        \"memes.Care\": 1,\n        \"boastful\": true,\n        \"plan\": null,\n        \"performed\": false,\n        \"performance_style\": \"boastful\"\n      }\n    },\n    \"bram\": {\n      \"name\": \"Bram\",\n      \"kind\": \"adult\",\n      \"state\": {\n        \"want\": \"help the parade work\",\n        \"memes.Care\": 2\n      }\n    },\n    \"readers\": {\n      \"name\": \"The Young Readers\",\n      \"kind\": \"audience\",\n      \"state\": {\n        \"need\": \"books\",\n        \"response\": false,\n        \"mood\": \"waiting\"\n      }\n    },\n    \"library\": {\n      \"name\": \"Library\",\n      \"kind\": \"place\",\n      \"state\": {}\n    },\n    \"workshop\": {\n      \"name\": \"Workshop\",\n      \"kind\": \"place\",\n      \"state\": {}\n    },\n    \"square\": {\n      \"name\": \"Parade Square\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"wind\": \"still\"\n      }\n    },\n    \"cart\": {\n      \"name\": \"The Shared Cart\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"bram\",\n        \"location\": \"workshop\",\n        \"loaned_by\": null,\n        \"wheel\": \"wobbly\"\n      }\n    },\n    \"books\": {\n      \"name\": \"The Library Books\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"library\",\n        \"contents\": \"books\",\n        \"delivered\": false\n      }\n    },\n    \"banner\": {\n      \"name\": \"The Parade Banner\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"mayor\",\n        \"location\": \"hall\",\n        \"secured\": false\n      }\n    },\n    \"hall\": {\n      \"name\": \"Town Hall\",\n      \"kind\": \"place\",\n      \"state\": {}\n    }\n  },\n  \"vary\": {\n    \"weather\": [\n      {\n        \"square.wind\": \"still\"\n      },\n      {\n        \"square.wind\": \"breezy\"\n      }\n    ],\n    \"cart_condition\": [\n      {\n        \"cart.wheel\": \"wobbly\"\n      },\n      {\n        \"cart.wheel\": \"ready\"\n      }\n    ],\n    \"reader_need\": [\n      {\n        \"readers.need\": \"books\",\n        \"books.contents\": \"books\"\n      },\n      {\n        \"readers.need\": \"maps\",\n        \"books.contents\": \"maps\"\n      }\n    ]\n  },\n  \"premises\": [\n    \"square.wind\",\n    \"cart.wheel\",\n    \"readers.need\",\n    \"books.contents\"\n  ],\n  \"compose\": {\n    \"wind_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"mayor\",\n        \"square.wind\"\n      ]\n    },\n    \"need_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"mayor\",\n        \"readers.need\"\n      ]\n    },\n    \"repair_cart\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"bram\"\n      ],\n      \"when\": {\n        \"cart.location\": \"workshop\",\n        \"cart.wheel\": \"wobbly\"\n      },\n      \"set\": {\n        \"cart.wheel\": \"ready\"\n      },\n      \"summary\": \"Bram steadies the cart wheel\",\n      \"pivotal\": false\n    },\n    \"lend_cart\": {\n      \"op\": \"Lend\",\n      \"args\": [\n        \"bram\",\n        \"ada\",\n        \"cart\"\n      ],\n      \"when\": {\n        \"cart.wheel\": \"ready\"\n      },\n      \"summary\": \"Bram lends Ada the cart\"\n    },\n    \"move_cart\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"cart\",\n        \"square\"\n      ],\n      \"when\": {\n        \"cart.owner\": \"ada\"\n      },\n      \"summary\": \"Ada rolls the cart to the square\"\n    },\n    \"move_books\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"books\",\n        \"square\"\n      ],\n      \"when\": {\n        \"books.owner\": \"ada\",\n        \"cart.location\": \"square\"\n      },\n      \"summary\": \"Ada brings the books to the square\"\n    },\n    \"deliver_books\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"books.location\": \"square\",\n        \"books.contents\": \"books\",\n        \"readers.need\": \"books\",\n        \"mayor.plan\": \"helpful\"\n      },\n      \"set\": {\n        \"books.delivered\": true\n      },\n      \"summary\": \"Ada delivers the storybooks\",\n      \"pivotal\": true\n    },\n    \"deliver_maps\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"books.location\": \"square\",\n        \"books.contents\": \"maps\",\n        \"readers.need\": \"maps\",\n        \"mayor.plan\": \"helpful\"\n      },\n      \"set\": {\n        \"books.delivered\": true\n      },\n      \"summary\": \"Ada delivers the maps\",\n      \"pivotal\": true\n    },\n    \"move_banner\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"mayor\",\n        \"banner\",\n        \"square\"\n      ],\n      \"when\": {\n        \"banner.owner\": \"mayor\"\n      },\n      \"summary\": \"Mayor Bell carries the banner to the square\"\n    },\n    \"secure_banner\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": {\n        \"square.wind\": \"breezy\",\n        \"banner.location\": \"square\",\n        \"mayor.knows.square.wind\": \"breezy\"\n      },\n      \"set\": {\n        \"banner.secured\": true\n      },\n      \"summary\": \"Mayor Bell secures the windy banner\"\n    },\n    \"choose_helpful\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": {\n        \"mayor.knows.readers.need\": \"books\"\n      },\n      \"set\": {\n        \"mayor.plan\": \"helpful\",\n        \"mayor.boastful\": false\n      },\n      \"inc\": {\n        \"mayor.memes.Care\": 1\n      },\n      \"summary\": \"Mayor Bell chooses usefulness over boasting\",\n      \"pivotal\": true\n    },\n    \"choose_helpful_maps\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": {\n        \"mayor.knows.readers.need\": \"maps\"\n      },\n      \"set\": {\n        \"mayor.plan\": \"helpful\",\n        \"mayor.boastful\": false\n      },\n      \"inc\": {\n        \"mayor.memes.Care\": 1\n      },\n      \"summary\": \"Mayor Bell chooses usefulness over boasting\",\n      \"pivotal\": true\n    },\n    \"parade_still\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": {\n        \"cart.location\": \"square\",\n        \"books.delivered\": true,\n        \"square.wind\": \"still\",\n        \"mayor.plan\": \"helpful\"\n      },\n      \"set\": {\n        \"mayor.performed\": true,\n        \"mayor.performance_style\": \"welcoming\",\n        \"mayor.parade.outcome\": \"useful\"\n      },\n      \"summary\": \"Mayor Bell leads a welcoming book parade\"\n    },\n    \"parade_breezy\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"mayor\"\n      ],\n      \"when\": {\n        \"cart.location\": \"square\",\n        \"books.delivered\": true,\n        \"square.wind\": \"breezy\",\n        \"banner.secured\": true,\n        \"mayor.plan\": \"helpful\"\n      },\n      \"set\": {\n        \"mayor.performed\": true,\n        \"mayor.performance_style\": \"welcoming\",\n        \"mayor.parade.outcome\": \"useful\"\n      },\n      \"summary\": \"Mayor Bell leads a banner-bright book parade\"\n    },\n    \"readers_respond\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"readers\"\n      ],\n      \"when\": {\n        \"books.delivered\": true,\n        \"mayor.performed\": true\n      },\n      \"set\": {\n        \"readers.response\": true,\n        \"readers.mood\": \"delighted\"\n      },\n      \"summary\": \"The young readers cheer for the useful parade\",\n      \"pivotal\": true\n    }\n  },\n  \"goal\": {\n    \"books.delivered\": true,\n    \"mayor.performed\": true,\n    \"mayor.parade.outcome\": [\n      \"ne\",\n      \"none\"\n    ],\n    \"readers.response\": true\n  },\n  \"outcomes\": [\n    \"books.delivered\",\n    \"mayor.performed\",\n    \"mayor.parade.outcome\",\n    \"readers.response\",\n    \"readers.mood\",\n    \"mayor.boastful\"\n  ],\n  \"prune\": true\n}",
