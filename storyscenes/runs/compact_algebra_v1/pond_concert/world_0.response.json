          "text": "{\n  \"title\": \"The Pond Concert That Listened\",\n  \"premise\": \"A frog and two children want a pond concert, but a quiet neighbor, a breezy pond, and a mistaken assumption shape what kind of music can be shared.\",\n  \"entities\": {\n    \"ada\": {\n      \"name\": \"Ada\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"deliver invitations\",\n        \"memes.Care\": 2,\n        \"delivered\": false,\n        \"location\": \"cove\"\n      }\n    },\n    \"ben\": {\n      \"name\": \"Ben\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"build floating stage\",\n        \"location\": \"pond\"\n      }\n    },\n    \"frog\": {\n      \"name\": \"Frog\",\n      \"kind\": \"frog\",\n      \"state\": {\n        \"want\": \"perform for listeners\",\n        \"performance_style\": \"lively\",\n        \"performed\": false,\n        \"location\": \"pond\"\n      }\n    },\n    \"neighbor\": {\n      \"name\": \"Mira\",\n      \"kind\": \"neighbor\",\n      \"state\": {\n        \"want\": \"quiet\",\n        \"location\": \"cove\",\n        \"received\": false,\n        \"heard_music\": false,\n        \"joined\": false,\n        \"response\": \"none\"\n      }\n    },\n    \"pond\": {\n      \"name\": \"Pond\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"wind\": \"still\"\n      }\n    },\n    \"cove\": {\n      \"name\": \"Quiet Cove\",\n      \"kind\": \"place\",\n      \"state\": {}\n    },\n    \"bank\": {\n      \"name\": \"Pond Bank\",\n      \"kind\": \"place\",\n      \"state\": {}\n    },\n    \"invitation_card\": {\n      \"name\": \"invitation card\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"cove\"\n      }\n    },\n    \"stage\": {\n      \"name\": \"floating lily-pad stage\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ben\",\n        \"location\": \"bank\",\n        \"stage_ready\": false\n      }\n    },\n    \"ribbon\": {\n      \"name\": \"stage ribbon\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"bank\",\n        \"secured\": false\n      }\n    }\n  },\n  \"vary\": {\n    \"weather\": [\n      {\n        \"pond.wind\": \"still\"\n      },\n      {\n        \"pond.wind\": \"breezy\"\n      }\n    ],\n    \"listener\": [\n      {\n        \"neighbor.want\": \"quiet\"\n      },\n      {\n        \"neighbor.want\": \"join\"\n      }\n    ]\n  },\n  \"premises\": [\n    \"pond.wind\",\n    \"neighbor.want\"\n  ],\n  \"compose\": {\n    \"learn_listener_wish\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"frog\",\n        \"neighbor.want\"\n      ],\n      \"summary\": \"Ada learns and shares Mira's wish\",\n      \"pivotal\": true\n    },\n    \"learn_pond_wind\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ben\",\n        \"frog\",\n        \"pond.wind\"\n      ],\n      \"summary\": \"Ben learns and shares the pond wind\"\n    },\n    \"respect_quiet\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"ada.knows.neighbor.want\": \"quiet\"\n      },\n      \"set\": {\n        \"ada.memes.Care\": 3\n      },\n      \"label\": \"Ada chooses to respect a quiet wish\",\n      \"summary\": \"Ada chooses care over her assumption\",\n      \"pivotal\": true\n    },\n    \"deliver_card\": {\n      \"op\": \"Transfer\",\n      \"args\": [\n        \"ada\",\n        \"neighbor\",\n        \"invitation_card\"\n      ],\n      \"when\": {\n        \"invitation_card.location\": \"cove\"\n      },\n      \"summary\": \"Ada gives Mira the invitation\"\n    },\n    \"mark_delivery\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"invitation_card.owner\": \"neighbor\"\n      },\n      \"set\": {\n        \"ada.delivered\": true,\n        \"neighbor.received\": true\n      },\n      \"summary\": \"Mira receives the invitation\"\n    },\n    \"ada_to_pond\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"ada.delivered\": true\n      },\n      \"set\": {\n        \"ada.location\": \"pond\"\n      },\n      \"summary\": \"Ada walks from the cove to the pond\"\n    },\n    \"lend_ribbon\": {\n      \"op\": \"Lend\",\n      \"args\": [\n        \"ada\",\n        \"ben\",\n        \"ribbon\"\n      ],\n      \"when\": {\n        \"ada.location\": \"pond\"\n      },\n      \"summary\": \"Ada lends Ben the ribbon\"\n    },\n    \"move_ribbon\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ben\",\n        \"ribbon\",\n        \"pond\"\n      ],\n      \"when\": {\n        \"ribbon.owner\": \"ben\"\n      },\n      \"summary\": \"Ben carries the ribbon to the pond\"\n    },\n    \"secure_ribbon\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ben\"\n      ],\n      \"when\": {\n        \"ribbon.owner\": \"ben\",\n        \"ribbon.location\": \"pond\",\n        \"pond.wind\": \"breezy\"\n      },\n      \"set\": {\n        \"ribbon.secured\": true\n      },\n      \"summary\": \"Ben secures the stage against the breeze\"\n    },\n    \"build_stage_still\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ben\"\n      ],\n      \"when\": {\n        \"ben.knows.pond.wind\": \"still\"\n      },\n      \"set\": {\n        \"stage.stage_ready\": true\n      },\n      \"summary\": \"Ben prepares the stage in calm water\",\n      \"pivotal\": true\n    },\n    \"build_stage_breezy\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ben\"\n      ],\n      \"when\": {\n        \"ben.knows.pond.wind\": \"breezy\",\n        \"ribbon.secured\": true\n      },\n      \"set\": {\n        \"stage.stage_ready\": true\n      },\n      \"summary\": \"Ben prepares the tied-down stage\",\n      \"pivotal\": true\n    },\n    \"float_stage\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ben\",\n        \"stage\",\n        \"pond\"\n      ],\n      \"when\": {\n        \"stage.stage_ready\": true\n      },\n      \"summary\": \"Ben floats the stage onto the pond\"\n    },\n    \"quiet_performance\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"frog\"\n      ],\n      \"when\": {\n        \"frog.knows.neighbor.want\": \"quiet\",\n        \"ada.memes.Care\": [\n          \"ge\",\n          3\n        ],\n        \"stage.location\": \"pond\",\n        \"stage.stage_ready\": true\n      },\n      \"set\": {\n        \"frog.performance_style\": \"soft ripple-song\",\n        \"frog.performed\": true,\n        \"neighbor.heard_music\": true,\n        \"neighbor.response\": \"listened\"\n      },\n      \"summary\": \"Frog performs a soft ripple-song\",\n      \"pivotal\": true\n    },\n    \"welcoming_performance\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"frog\"\n      ],\n      \"when\": {\n        \"frog.knows.neighbor.want\": \"join\",\n        \"stage.location\": \"pond\",\n        \"stage.stage_ready\": true\n      },\n      \"set\": {\n        \"frog.performance_style\": \"lively chorus\",\n        \"frog.performed\": true,\n        \"neighbor.heard_music\": true,\n        \"neighbor.joined\": true,\n        \"neighbor.response\": \"joined\"\n      },\n      \"summary\": \"Frog performs a lively chorus\",\n      \"pivotal\": true\n    }\n  },\n  \"goal\": {\n    \"ada.delivered\": true,\n    \"neighbor.received\": true,\n    \"stage.location\": \"pond\",\n    \"frog.performed\": true,\n    \"neighbor.heard_music\": true,\n    \"neighbor.response\": [\n      \"ne\",\n      \"none\"\n    ]\n  },\n  \"outcomes\": [\n    \"ada.delivered\",\n    \"neighbor.received\",\n    \"stage.location\",\n    \"stage.stage_ready\",\n    \"frog.performance_style\",\n    \"frog.performed\",\n    \"neighbor.heard_music\",\n    \"neighbor.response\"\n  ],\n  \"prune\": true\n