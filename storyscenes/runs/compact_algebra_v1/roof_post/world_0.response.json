          "text": "{\n  \"title\": \"The Windwise Invitations\",\n  \"premise\": \"Ada and a young dragon must deliver invitations across a roof garden while wind, fragile cargo, and the dragon's wish to help interact.\",\n  \"entities\": {\n    \"ada\": {\n      \"name\": \"Ada\",\n      \"kind\": \"child\",\n      \"state\": {\n        \"want\": \"deliver invitations\",\n        \"memes.Care\": 2\n      }\n    },\n    \"ember\": {\n      \"name\": \"Ember\",\n      \"kind\": \"young dragon\",\n      \"state\": {\n        \"want\": \"help deliver invitations\",\n        \"confidence\": \"hesitant\",\n        \"memes.Care\": 1,\n        \"ready\": false,\n        \"shielding\": false\n      }\n    },\n    \"invitations\": {\n      \"name\": \"invitations\",\n      \"kind\": \"fragile cargo\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"ada\",\n        \"fragile\": true,\n        \"secured\": false,\n        \"intact\": true,\n        \"delivered\": false\n      }\n    },\n    \"ribbon\": {\n      \"name\": \"blue ribbon\",\n      \"kind\": \"prop\",\n      \"state\": {\n        \"owner\": \"ada\",\n        \"location\": \"ada\",\n        \"tied\": false\n      }\n    },\n    \"garden\": {\n      \"name\": \"roof garden\",\n      \"kind\": \"place\",\n      \"state\": {\n        \"wind\": \"still\"\n      }\n    },\n    \"neighbor\": {\n      \"name\": \"Mina\",\n      \"kind\": \"neighbor\",\n      \"state\": {\n        \"want\": \"quiet\",\n        \"received\": false,\n        \"response\": \"none\"\n      }\n    }\n  },\n  \"vary\": {\n    \"weather\": [\n      {\n        \"garden.wind\": \"still\"\n      },\n      {\n        \"garden.wind\": \"breezy\"\n      },\n      {\n        \"garden.wind\": \"gusty\"\n      }\n    ],\n    \"recipient\": [\n      {\n        \"neighbor.want\": \"quiet\"\n      },\n      {\n        \"neighbor.want\": \"join\"\n      }\n    ],\n    \"confidence\": [\n      {\n        \"ember.confidence\": \"hesitant\"\n      },\n      {\n        \"ember.confidence\": \"eager\"\n      }\n    ]\n  },\n  \"premises\": [\n    \"garden.wind\",\n    \"neighbor.want\",\n    \"ember.confidence\"\n  ],\n  \"kernels\": {},\n  \"compose\": {\n    \"wind_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ada\",\n        \"ember\",\n        \"garden.wind\"\n      ],\n      \"summary\": \"Ada shares the garden wind\"\n    },\n    \"wish_news\": {\n      \"op\": \"DiscoverAndShare\",\n      \"args\": [\n        \"ember\",\n        \"ada\",\n        \"neighbor.want\"\n      ],\n      \"summary\": \"Ember shares Mina's wish\"\n    },\n    \"secure_cargo\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"ada.knows.garden.wind\": [\n          \"ne\",\n          null\n        ],\n        \"invitations.owner\": \"ada\",\n        \"ribbon.owner\": \"ada\",\n        \"ribbon.tied\": false,\n        \"invitations.secured\": false\n      },\n      \"set\": {\n        \"invitations.secured\": true,\n        \"ribbon.tied\": true\n      },\n      \"summary\": \"Ada ties the invitations securely\"\n    },\n    \"choose_to_help\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ember\"\n      ],\n      \"when\": {\n        \"ember.knows.garden.wind\": [\n          \"ne\",\n          null\n        ],\n        \"ember.knows.neighbor.want\": [\n          \"ne\",\n          null\n        ],\n        \"ember.want\": \"help deliver invitations\",\n        \"ember.ready\": false\n      },\n      \"set\": {\n        \"ember.ready\": true,\n        \"ember.shielding\": true\n      },\n      \"inc\": {\n        \"ember.memes.Care\": 1\n      },\n      \"pivotal\": true,\n      \"label\": \"Ember chooses to help\",\n      \"summary\": \"Ember chooses to shield the cargo\"\n    },\n    \"lend_invitations\": {\n      \"op\": \"Lend\",\n      \"args\": [\n        \"ada\",\n        \"ember\",\n        \"invitations\"\n      ],\n      \"when\": {\n        \"ember.ready\": true,\n        \"invitations.secured\": true,\n        \"invitations.location\": \"ada\"\n      },\n      \"summary\": \"Ada lends Ember the invitations\"\n    },\n    \"ada_carries\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ada\",\n        \"invitations\",\n        \"neighbor\"\n      ],\n      \"when\": {\n        \"invitations.owner\": \"ada\",\n        \"invitations.secured\": true,\n        \"invitations.intact\": true,\n        \"invitations.delivered\": false\n      },\n      \"summary\": \"Ada carries the invitations to Mina\"\n    },\n    \"ember_carries\": {\n      \"op\": \"Move\",\n      \"args\": [\n        \"ember\",\n        \"invitations\",\n        \"neighbor\"\n      ],\n      \"when\": {\n        \"invitations.owner\": \"ember\",\n        \"ember.ready\": true,\n        \"ember.shielding\": true,\n        \"invitations.intact\": true,\n        \"invitations.delivered\": false\n      },\n      \"summary\": \"Ember carries the shielded invitations to Mina\"\n    },\n    \"ada_delivers\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ada\"\n      ],\n      \"when\": {\n        \"invitations.owner\": \"ada\",\n        \"invitations.location\": \"neighbor\",\n        \"invitations.intact\": true,\n        \"invitations.delivered\": false\n      },\n      \"set\": {\n        \"invitations.delivered\": true,\n        \"neighbor.received\": true\n      },\n      \"summary\": \"Ada delivers the intact invitations\"\n    },\n    \"ember_delivers\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"ember\"\n      ],\n      \"when\": {\n        \"invitations.owner\": \"ember\",\n        \"invitations.location\": \"neighbor\",\n        \"invitations.intact\": true,\n        \"invitations.delivered\": false\n      },\n      \"set\": {\n        \"invitations.delivered\": true,\n        \"neighbor.received\": true\n      },\n      \"summary\": \"Ember delivers the intact invitations\"\n    },\n    \"quiet_response\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"neighbor\"\n      ],\n      \"when\": {\n        \"neighbor.received\": true,\n        \"neighbor.want\": \"quiet\",\n        \"neighbor.response\": \"none\"\n      },\n      \"set\": {\n        \"neighbor.response\": \"thanks for the quiet invitation\"\n      },\n      \"summary\": \"Mina thanks them for the quiet invitation\"\n    },\n    \"join_response\": {\n      \"op\": \"Act\",\n      \"actors\": [\n        \"neighbor\"\n      ],\n      \"when\": {\n        \"neighbor.received\": true,\n        \"neighbor.want\": \"join\",\n        \"neighbor.response\": \"none\"\n      },\n      \"set\": {\n        \"neighbor.response\": \"Mina joins the garden gathering\"\n      },\n      \"summary\": \"Mina joins the garden gathering\"\n    }\n  },\n  \"goal\": {\n    \"invitations.delivered\": true,\n    \"neighbor.received\": true,\n    \"neighbor.response\": [\n      \"ne\",\n      \"none\"\n    ]\n  },\n  \"outcomes\": [\n    \"invitations.delivered\",\n    \"invitations.intact\",\n    \"neighbor.received\",\n    \"neighbor.response\",\n    \"ember.memes.Care\"\n  ],\n  \"prune\": true\n}",
